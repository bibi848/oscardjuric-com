---
import Layout from '../layouts/Layout.astro';

const projects = [
  { name: "Personal Website", desc: "Built with Astro and hosted on Cloudflare" },
  { name: "Cool App", desc: "Work in progress project" }
];
---

<Layout title="Projects | Oscar Djuric">
  <h1>My Projects</h1>
  
  {projects.map((project) => (
    <div style="margin-bottom: 1.5rem;">
      <h3>{project.name}</h3>
      <p>{project.desc}</p>
    </div>
  ))}
</Layout>