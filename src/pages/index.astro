---
import Layout from '../layouts/Layout.astro';
import CursorEye from '../components/CursorEye.astro';
import PointingHand from '../components/PointingHand.astro';

// Lightweight preview data for the homepage — date + title only.
const educationPreview = [
  { period: '10/2026 – Present', title: 'PhD, Computational Engineering' },
  { period: '09/2022 – 06/2026', title: 'MEng, Mechanical Engineering' },
  { period: '07/2024 – 07/2025', title: 'University Year Abroad' },
  { period: '09/2020 – 07/2022', title: 'A Levels' },
];

const experiencePreview = [
  { period: '06/2026 – 09/2026', title: 'SWE Intern, Cloudflare' },
  { period: '07/2025 – 09/2025', title: 'Data & Analytics Intern, Salute' },
  { period: '11/2024 – 04/2025', title: 'Engineering Research Intern, QUT' },
];

const projectPreview = [
  { name: "University Master's Project", tagline: 'Automated ultrasonic scanning & signal processing' },
  { name: 'Raytracing', tagline: 'C++ raytracing engine for concentrated solar power' },
  { name: 'gD-algo', tagline: 'Financial programming, market data & trading systems' },
];
---

<Layout title="Oscar Djuric">
  <canvas id="particle-canvas" aria-hidden="true"></canvas>

  <section class="hero">
    <div class="hero-content" id="hero-content">
      <h1 class="name dither-text dither-name" data-dither-text="OSCAR DJURIC">
        <span class="first">OSCAR</span>
        <span class="last">DJURIC</span>
      </h1>
      <p class="tagline"><span id="typing-line"></span><span class="typing-cursor" aria-hidden="true">_</span></p>
    </div>
    <CursorEye />
    <div class="scroll-hint" id="scroll-hint">
      <span>Scroll</span>
      <span class="arrow">&darr;</span>
    </div>
  </section>

  <div class="page-wrapper">
    <section class="content-section about">
      <h2>About</h2>
      <p>
        I'm a PhD student working on high-performance computing methods for
        aeronautical simulations, with the Nektar++ group at Imperial College London. My work focuses on novel algorithms for load rebalancing of adaptive mesh simulations on heterogeneous clusters, partnering with McLaren F1, Rolls-Royce, and UKAEA. I specialise in C++, Python, and data-driven engineering solutions.
      </p>
    </section>

    <section class="content-section preview-block">
      <h2>Education &amp; Experience</h2>
      <div class="preview-grid">
        <div class="preview-col">
          <h3>Education</h3>
          <ul class="preview-list">
            {educationPreview.map((item) => (
              <li>
                <span class="preview-period">{item.period}</span>
                <span class="preview-title">{item.title}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="preview-col">
          <h3>Experience</h3>
          <ul class="preview-list">
            {experiencePreview.map((item) => (
              <li>
                <span class="preview-period">{item.period}</span>
                <span class="preview-title">{item.title}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <a href="/experience" class="read-more">Open full record <span>&rarr;</span></a>
      <div class="frame-particles" aria-hidden="true"></div>
    </section>

    <section class="content-section preview-block projects-preview">
      <h2>Projects</h2>
      <div class="project-preview-list">
        {projectPreview.map((project) => (
          <a href="/projects" class="project-preview-item">
            <span class="preview-title">{project.name}</span>
            <span class="preview-period">{project.tagline}</span>
          </a>
        ))}
      </div>
      <a href="/projects" class="read-more">View all projects <span>&rarr;</span></a>
      <div class="frame-particles" aria-hidden="true"></div>
    </section>

    <section class="content-section cta framed-cta">
      <h2>Let's Connect</h2>
      <p>Want to work together? <a href="/contact">Get in touch</a></p>
      <div class="frame-particles" aria-hidden="true"></div>
    </section>
  </div>

  <PointingHand />
</Layout>

<style>
  /* --- Particle canvas --- */
  #particle-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    display: block;
    transition: opacity 0.15s linear;
  }

  .hero {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1;
      height: 100svh;
      padding: 0px 1.5rem 200;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      background: transparent;
      overflow: hidden;
      pointer-events: none;
    }

  .hero-content {
      pointer-events: auto;
      will-change: opacity;
      width: min(40rem, calc(100vw - 3rem));
      margin-left: max(0px, calc((100vw - 1100px) / 2));
    }

  .name {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.02em;
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: clamp(3.25rem, 12vw, 8.5rem);
  }

  .name .first,
  .name .last {
    color: var(--color-fuchsia);
    transition: opacity 0.2s ease;
  }

  .dither-text-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    image-rendering: pixelated;
  }

  .tagline {
    margin: 1.5rem 0 0.25rem;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    color: var(--color-white);
    max-width: 34rem;
    min-height: 1.7em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .typing-cursor {
    color: var(--color-fuchsia);
    animation: blink 0.85s steps(1) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .dept {
    margin: 0;
    font-size: 0.95rem;
    color: #888;
    letter-spacing: 0.01em;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #777;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .scroll-hint .arrow {
    display: inline-block;
    animation: bob 1.8s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  .page-wrapper {
    /* Accent colour for the framed blocks below the About section
       (Education & Experience, Projects preview, Let's Connect).
       Tied to the same variable the section headings (h2) use, so it
       always matches "About", "Education & Experience", etc. Change
       --color-fuchsia-soft in Layout.astro to move both at once. */
    --block-accent: var(--color-fuchsia-soft);

    position: relative;
    z-index: 2;
    margin-top: 80vh;
    background: rgba(10, 10, 10, 0);
    padding: 4rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* --- Content sections --- */
  .content-section {
    width: 100%;
    max-width: 40rem;
    margin-bottom: 2.5rem;
    opacity: 0.001;
    transform: translateY(40px);
    transition: opacity 0.7s ease, transform 0.9s cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .content-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .content-section > p {
    color: var(--color-white);
    line-height: 1.6;
  }

  /* --- Education & Experience preview block --- */
  .preview-block {
    position: relative;
    overflow: visible;
    border: 1px solid var(--block-accent);
    border-radius: 10px;
    background-color: rgba(19, 19, 19, 0.8);
    padding: 1.75rem 1.75rem 1.5rem;
  }

  .preview-block h2 {
    margin-top: 0;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    margin-top: 1rem;
  }

  .preview-col h3 {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #888;
    font-weight: 600;
  }

  .preview-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .preview-list li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .preview-period {
    color: #888;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .preview-title {
    color: var(--color-white);
    font-size: 0.92rem;
    line-height: 1.3;
  }

  .read-more {
    display: inline-block;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid #262626;
    width: 100%;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--block-accent);
  }

  .read-more:hover {
    text-decoration: underline;
  }

  .cta {
    margin: 0;
    padding: 1.25rem 1.75rem;
  }

  .framed-cta h2 {
    margin-top: 0;
  }

  .framed-cta {
    position: relative;
    overflow: visible;
    border: 1px solid var(--block-accent);
    border-radius: 10px;
    background-color: rgba(19, 19, 19, 0.8);
  }

  .preview-block > *:not(.frame-particles),
  .framed-cta > *:not(.frame-particles) {
    position: relative;
    z-index: 1;
  }


  .project-preview-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .project-preview-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid #2a2022;
    background: rgba(10, 10, 10, 0.55);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .project-preview-item:hover {
    border-color: var(--block-accent);
    transform: translateX(4px);
  }

  /* Dithered pixel border + escaping particles, drawn on a canvas that
     overlaps each block. See the "DITHERED FRAME PARAMETERS" section in
     the script below to tune thickness, spawn rate, colour, etc. */
  .frame-particles {
    position: absolute;
    inset: -46px; /* overwritten inline by JS to match FRAME_PAD */
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }

  .frame-dither-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
    image-rendering: -webkit-optimize-contrast;
  }

  @media (prefers-reduced-motion: reduce) {
    .content-section {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .scroll-hint .arrow {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .hero-content { margin-left: 0; }

    .preview-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>

<script>
  // --- Hero fade + static handling ---
  const heroContent = document.getElementById('hero-content');
  const scrollHint = document.getElementById('scroll-hint');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const contentSections = Array.from(document.querySelectorAll<HTMLElement>('.content-section'));

  function updateHero() {
    const vh = window.innerHeight;
    const progress = Math.min(window.scrollY / (vh * 0.72), 1);
    if (heroContent) {
      heroContent.style.opacity = String(1 - progress);
    }
    if (scrollHint) scrollHint.style.opacity = String(Math.max(0, 1 - progress * 3));
  }

  window.addEventListener('scroll', updateHero, { passive: true });
  updateHero();

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    contentSections.forEach((section) => observer.observe(section));
  } else {
    contentSections.forEach((section) => section.classList.add('is-visible'));
  }

  // --- Shared visual dither switch ---
  // Set to false to compare against smooth particles.
  const DITHER_ENABLED = true;

  const BAYER4 = [
    [0, 8, 2, 10],
    [12, 4, 14, 6],
    [3, 11, 1, 9],
    [15, 7, 13, 5],
  ].map((row) => row.map((v) => (v + 0.5) / 16));

  function clamp01(v: number) {
    return Math.max(0, Math.min(1, v));
  }

  function smoothstep(edge0: number, edge1: number, x: number) {
    const t = clamp01((x - edge0) / (edge1 - edge0));
    return t * t * (3 - 2 * t);
  }

  // --- Viscous fuchsia cursor particles ---
  const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d') ?? null;

  function updateCanvasFade() {
    if (!canvas) return;
    const vh = window.innerHeight;
    const progress = Math.min(window.scrollY / (vh * 0.72), 1);
    canvas.style.opacity = String(1 - progress);
  }
  window.addEventListener('scroll', updateCanvasFade, { passive: true });
  updateCanvasFade();

  if (canvas && ctx) {
    type Particle = {
      x: number; y: number; vx: number; vy: number;
      r: number; life: number; maxLife: number; color: string;
      wobble: number; seed: number;
    };

    let particles: Particle[] = [];
    let cursorX = window.innerWidth / 2;
    let cursorY = window.innerHeight / 2;
    let previousX = cursorX;
    let previousY = cursorY;
    let running = window.scrollY < 12;
    const colors = ['#af4a5a'];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    function setRunning() {
      running = window.scrollY < 12;
    }
    window.addEventListener('scroll', setRunning, { passive: true });

    function spawn(x: number, y: number) {
      if (!running) return;
      const dx = x - previousX;
      const dy = y - previousY;
      const speed = Math.min(Math.hypot(dx, dy), 34);
      const count = Math.min(8, 3 + Math.floor(speed / 7));

      for (let i = 0; i < count; i++) {
        const angle = Math.atan2(dy, dx) + Math.PI + (Math.random() - 0.5) * 0.9;
        const force = 0.35 + Math.random() * 1.2 + speed * 0.035;
        const maxLife = 80 + Math.random() * 70;
        particles.push({
          x: x - dx * Math.random() * 0.5,
          y: y - dy * Math.random() * 0.5,
          vx: Math.cos(angle) * force,
          vy: Math.sin(angle) * force,
          r: 1.4 + Math.random() * 3.4,
          life: maxLife,
          maxLife,
          color: colors[Math.floor(Math.random() * colors.length)],
          wobble: 0.015 + Math.random() * 0.02,
          seed: Math.random() * Math.PI * 2,
        });
      }

      if (particles.length > 1200) particles.splice(0, particles.length - 1200);
      previousX = x;
      previousY = y;
    }

    function onMove(e: MouseEvent | TouchEvent) {
      const point = 'touches' in e ? e.touches[0] : e;
      if (!point) return;
      cursorX = point.clientX;
      cursorY = point.clientY;
      spawn(cursorX, cursorY);
    }

    if (!reduceMotion) {
      window.addEventListener('mousemove', onMove);
      window.addEventListener('touchmove', onMove, { passive: true });
    }

    function tick(time: number) {
      if (!ctx || !canvas) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (const p of particles) {
        p.vx *= 0.965;
        p.vy *= 0.965;
        p.vx += Math.cos(time * p.wobble + p.seed) * 0.008;
        p.vy += Math.sin(time * p.wobble + p.seed) * 0.008;
        p.x += p.vx;
        p.y += p.vy;
        p.life -= 1;

        const life = Math.max(p.life / p.maxLife, 0);
        const radius = Math.max(p.r * (0.55 + life * 0.65), 0);

        ctx.fillStyle = p.color;

        if (DITHER_ENABLED) {
          /*
           * Render particles as tiny Bayer-dithered blobs rather than
           * anti-aliased circles. The edge breaks into individual pixels,
           * matching the eye's halftone treatment.
           */
          const minX = Math.floor(p.x - radius - 1);
          const maxX = Math.ceil(p.x + radius + 1);
          const minY = Math.floor(p.y - radius - 1);
          const maxY = Math.ceil(p.y + radius + 1);

          for (let py = minY; py <= maxY; py++) {
            for (let px = minX; px <= maxX; px++) {
              const nx = (px + 0.5 - p.x) / Math.max(radius, 0.5);
              const ny = (py + 0.5 - p.y) / Math.max(radius, 0.5);
              const distance = Math.hypot(nx, ny);

              if (distance >= 1) continue;

              /*
               * Soft circular falloff, then Bayer thresholding. This
               * produces irregular little clusters instead of spheres.
               */
              const edge = 1 - smoothstep(0.45, 1, distance);
              const threshold =
                BAYER4[((py % 4) + 4) % 4][((px % 4) + 4) % 4];

              if (life * edge * 0.95 > threshold) {
                ctx.fillRect(px, py, 1, 1);
              }
            }
          }
        } else {
          ctx.globalAlpha = life * 0.85;
          ctx.beginPath();
          ctx.arc(p.x, p.y, radius, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
        }
      }

      ctx.globalAlpha = 1;
      particles = particles.filter((p) => p.life > 0);
      requestAnimationFrame(tick);
    }

    if (!reduceMotion) requestAnimationFrame(tick);
  }

  // --- Typewriter caption ---
  const typingLine = document.getElementById('typing-line');
  const captions = [
    'PhD @ Imperial College London',
    'Mechanical Engineer / HPC Researcher',
    'Computational Engineering / Nektar++'
  ];
  
  if (typingLine) {
    let captionIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const typeLoop = () => {
      if (reduceMotion) {
        typingLine.textContent = captions[0];
        return;
      }

      const current = captions[captionIndex];
      charIndex += deleting ? -1 : 1;
      typingLine.textContent = current.slice(0, charIndex);

      let delay = deleting ? 35 : 65;
      if (!deleting && charIndex === current.length) {
        deleting = true;
        delay = 1900;
      } else if (deleting && charIndex === 0) {
        deleting = false;
        captionIndex = (captionIndex + 1) % captions.length;
        delay = 350;
      }

      window.setTimeout(typeLoop, delay);
    };

    typeLoop();
  }

  // --- Dithered hero name ---
  function renderDitherText(element: HTMLElement) {
    if (!DITHER_ENABLED) return;
    const text = element.dataset.ditherText || element.textContent?.trim() || '';
    if (!text) return;

    const rect = element.getBoundingClientRect();
    const scale = Math.min(window.devicePixelRatio || 1, 2);
    const canvas = document.createElement('canvas');
    canvas.className = 'dither-text-canvas';
    canvas.width = Math.ceil(rect.width * scale);
    canvas.height = Math.ceil(rect.height * scale);
    canvas.style.width = `${rect.width}px`;
    canvas.style.height = `${rect.height}px`;
    canvas.setAttribute('aria-hidden', 'true');

    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.scale(scale, scale);
    ctx.font = getComputedStyle(element).font;
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';

    const computed = getComputedStyle(element);
    const lineHeight = parseFloat(computed.lineHeight) || rect.height;
    const fontSize = parseFloat(computed.fontSize) || 96;
    const lines = text.split(' ');
    // Preserve the existing two-line visual layout.
    const lineTexts = element.classList.contains('dither-name') && lines.length === 2 ? lines : [text];
    const firstWidth = ctx.measureText(lineTexts[0]).width;
    const secondY = lineHeight * 0.88;
    const density = 0.72;

    ctx.clearRect(0, 0, rect.width, rect.height);
    for (let line = 0; line < lineTexts.length; line++) {
      const y = line === 0 ? 0 : secondY;
      const metrics = ctx.measureText(lineTexts[line]);
      const width = metrics.width + 4;
      const h = Math.ceil(fontSize * 1.05);
      const pixels = ctx.getImageData(0, 0, 1, 1);

      // Render into a temporary mask so every letter edge can dissolve.
      const mask = document.createElement('canvas');
      mask.width = Math.ceil(width);
      mask.height = h;
      const m = mask.getContext('2d');
      if (!m) continue;
      m.font = computed.font;
      m.textBaseline = 'top';
      m.fillStyle = '#fff';
      m.fillText(lineTexts[line], 0, 0);
      const data = m.getImageData(0, 0, mask.width, mask.height).data;

      for (let py = 0; py < mask.height; py += 2) {
        for (let px = 0; px < mask.width; px += 2) {
          const alpha = data[(py * mask.width + px) * 4 + 3] / 255;
          if (alpha <= 0) continue;
          const edgeFade = Math.min(1, alpha * 1.25);
          const threshold = BAYER4[(py / 2) % 4][(px / 2) % 4];
          const jitter = ((Math.sin(px * 12.7 + py * 4.1) + 1) * 0.5) * 0.22;
          if (edgeFade * density > threshold - jitter) {
            ctx.fillStyle = '#af4a5a';
            ctx.fillRect(px, y + py, 2, 2);
          }
        }
      }
    }

    element.querySelectorAll(':scope > .first, :scope > .last').forEach((child) => {
      (child as HTMLElement).style.visibility = 'hidden';
    });
    element.appendChild(canvas);
  }

  const ditherName = document.querySelector<HTMLElement>('.dither-name');
  if (ditherName) {
    const render = () => {
      ditherName.querySelector('.dither-text-canvas')?.remove();
      ditherName.querySelectorAll(':scope > .first, :scope > .last').forEach((child) => {
        (child as HTMLElement).style.visibility = 'visible';
      });
      renderDitherText(ditherName);
    };
    if (document.fonts?.ready) document.fonts.ready.then(render); else render();
    window.addEventListener('resize', render);
  }

  // --- Scroll speed tracker (used to pulse the dithered frames faster
  //     while the page is being scrolled quickly) ---
  const frameSpeed = { value: 0 };
  let lastScrollY = window.scrollY;
  let lastScrollTime = performance.now();

  function updateScrollSpeed() {
    const now = performance.now();
    const dt = Math.max(now - lastScrollTime, 16);
    frameSpeed.value = Math.min(Math.abs(window.scrollY - lastScrollY) / dt * 16, 4);
    lastScrollY = window.scrollY;
    lastScrollTime = now;
  }
  window.addEventListener('scroll', updateScrollSpeed, { passive: true });

  // =================================================================
  // DITHERED FRAME PARAMETERS — the pixelated border + particle
  // effect that surrounds the About-section blocks (Education &
  // Experience, Projects preview, Let's Connect). The border itself
  // stays aligned to the block; FRAME_PAD only provides room for the
  // dither transition and escaping particles.
  // =================================================================
  // Reads --color-fuchsia-soft (the same variable h2 titles use) at
  // runtime, so the dithered border always matches the headings even
  // if you change that variable later. Falls back to the fuchsia if
  // the variable isn't found for some reason.
  const FRAME_DITHER_COLOR =
    getComputedStyle(document.documentElement).getPropertyValue('--color-fuchsia-soft').trim() ||
    '#af4a5a';
  const FRAME_BORDER_BAND = 2;       // px: thickness of the solid-ish pixel border
  const FRAME_TRANSITION = 12;       // px: how far the border dissolves into dither before it's just loose particles
  const FRAME_PAD = 46;              // px: canvas padding around each block — must exceed transition + particle travel distance, and matches the .frame-particles inset above
  const FRAME_SPAWN_CHANCE = 0.55;   // 0–1: probability a new particle batch spawns each frame
  const FRAME_SPAWN_PER_100PX = 50;   // particles spawned per 100px of block perimeter, per batch
  const FRAME_MAX_PARTICLES = 600;   // hard cap per block, keeps things performant
  const FRAME_PARTICLE_SIZE: [number, number] = [1, 2.4];       // px [min, max]
  const FRAME_PARTICLE_SPEED: [number, number] = [0.12, 0.55];  // px/frame outward drift [min, max]
  const FRAME_PARTICLE_DRIFT = 0.35;                            // sideways wobble strength
  const FRAME_PARTICLE_DECAY: [number, number] = [0.006, 0.016];// alpha lost per frame [min, max]
  // =================================================================

  interface FrameParticle {
    x: number; y: number; vx: number; vy: number;
    size: number; alpha: number; decay: number;
    wobbleSeed: number; wobbleSpeed: number;
  }

  interface DitherFrameState {
    block: HTMLElement;
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    width: number;
    height: number;
    particles: FrameParticle[];
  }

  function perimeter(w: number, h: number) {
    return 2 * (w + h);
  }

  function drawDitherEdge(state: DitherFrameState) {
    const { ctx, width: w, height: h } = state;
    const pad = FRAME_PAD;
    const band = FRAME_BORDER_BAND;
    const trans = FRAME_TRANSITION;
    const span = band + trans;

    ctx.fillStyle = FRAME_DITHER_COLOR;

    // Top + bottom edges (the loop range covers the corners too).
    for (let d = 0; d < span; d += 2) {
      const solid = d < band;
      const threshold = solid ? 1 : 1 - (d - band) / trans;

      for (let x = 0; x < w; x += 2) {
        const bx = pad + x;
        const bayer = BAYER4[Math.floor(d / 2) % 4][Math.floor(bx / 2) % 4];
        if (solid || threshold > bayer) {
          ctx.fillRect(bx, pad - d, 2, 2);
          ctx.fillRect(bx, pad + h + d - 2, 2, 2);
        }
      }
    }

    // Left + right edges.
    for (let d = 0; d < span; d += 2) {
      const solid = d < band;
      const threshold = solid ? 1 : 1 - (d - band) / trans;

      for (let y = 0; y < h; y += 2) {
        const by = pad + y;
        const bayer = BAYER4[Math.floor(by / 2) % 4][Math.floor(d / 2) % 4];
        if (solid || threshold > bayer) {
          ctx.fillRect(pad - d, by, 2, 2);
          ctx.fillRect(pad + w + d - 2, by, 2, 2);
        }
      }
    }
  }

  function spawnFrameParticles(state: DitherFrameState, count: number) {
    const { width: w, height: h, particles } = state;
    const total = perimeter(w, h);

    for (let i = 0; i < count; i++) {
      let d = Math.random() * total;
      let x: number, y: number, nx: number, ny: number;

      if (d < w) { x = d; y = 0; nx = 0; ny = -1; }
      else if ((d -= w) < h) { x = w; y = d; nx = 1; ny = 0; }
      else if ((d -= h) < w) { x = w - d; y = h; nx = 0; ny = 1; }
      else { d -= w; x = 0; y = h - d; nx = -1; ny = 0; }

      const speed = FRAME_PARTICLE_SPEED[0] + Math.random() * (FRAME_PARTICLE_SPEED[1] - FRAME_PARTICLE_SPEED[0]);

      particles.push({
        x, y,
        vx: nx * speed, vy: ny * speed,
        size: FRAME_PARTICLE_SIZE[0] + Math.random() * (FRAME_PARTICLE_SIZE[1] - FRAME_PARTICLE_SIZE[0]),
        alpha: 0.75 + Math.random() * 0.25,
        decay: FRAME_PARTICLE_DECAY[0] + Math.random() * (FRAME_PARTICLE_DECAY[1] - FRAME_PARTICLE_DECAY[0]),
        wobbleSeed: Math.random() * Math.PI * 2,
        wobbleSpeed: 0.02 + Math.random() * 0.03,
      });
    }

    if (particles.length > FRAME_MAX_PARTICLES) {
      particles.splice(0, particles.length - FRAME_MAX_PARTICLES);
    }
  }

  function stepDitherFrame(state: DitherFrameState, pulse: number) {
    const { ctx, width: w, height: h, particles } = state;
    const pad = FRAME_PAD;

    ctx.clearRect(0, 0, w + pad * 2, h + pad * 2);
    drawDitherEdge(state);

    const chance = FRAME_SPAWN_CHANCE * (0.4 + pulse * 0.6);
    if (Math.random() < chance) {
      const count = Math.max(1, Math.round((perimeter(w, h) / 100) * FRAME_SPAWN_PER_100PX));
      spawnFrameParticles(state, count);
    }

    ctx.fillStyle = FRAME_DITHER_COLOR;
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.vx += Math.cos(p.wobbleSeed) * FRAME_PARTICLE_DRIFT * 0.01;
      p.vy += Math.sin(p.wobbleSeed) * FRAME_PARTICLE_DRIFT * 0.01;
      p.wobbleSeed += p.wobbleSpeed;
      p.x += p.vx;
      p.y += p.vy;
      p.alpha -= p.decay;

      if (p.alpha <= 0) {
        particles.splice(i, 1);
        continue;
      }

      ctx.globalAlpha = Math.max(0, p.alpha);
      ctx.fillRect(Math.round(pad + p.x), Math.round(pad + p.y), p.size, p.size);
    }
    ctx.globalAlpha = 1;
  }

  function makeDitherFrame(container: HTMLElement): DitherFrameState | null {
    const block = container.parentElement as HTMLElement | null;
    if (!block) return null;

    // Guard against duplicate mounts (e.g. dev-server hot reloads
    // re-running this script without a full page refresh) — without
    // this, a second stray canvas would stack on top of the first
    // and could report a stale/mismatched size, which is what caused
    // the border to overshoot the box.
    container.querySelectorAll('.frame-dither-canvas').forEach((el) => el.remove());

    // Set the inset BEFORE measuring, so the very first measurement
    // already reflects the padded box.
    container.style.inset = `-${FRAME_PAD}px`;

    const canvas = document.createElement('canvas');
    canvas.className = 'frame-dither-canvas';
    container.appendChild(canvas);
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;

    const state: DitherFrameState = { block, canvas, ctx, width: 0, height: 0, particles: [] };

    function resize() {
      // Measure the padded CONTAINER itself (not the block + an
      // assumed pad) so the canvas can never drift out of sync with
      // its own inset — this is the single source of truth for size.
      const rect = container.getBoundingClientRect();
      const totalW = Math.max(1, Math.round(rect.width));
      const totalH = Math.max(1, Math.round(rect.height));
      state.width = Math.max(1, totalW - FRAME_PAD * 2);
      state.height = Math.max(1, totalH - FRAME_PAD * 2);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(totalW * dpr);
      canvas.height = Math.round(totalH * dpr);
      canvas.style.width = `${totalW}px`;
      canvas.style.height = `${totalH}px`;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();
    window.addEventListener('resize', resize);
    if ('ResizeObserver' in window) new ResizeObserver(resize).observe(block);

    return state;
  }

  const ditherFrames = Array.from(document.querySelectorAll<HTMLElement>('.frame-particles'))
    .map(makeDitherFrame)
    .filter((s): s is DitherFrameState => s !== null);

  if (ditherFrames.length) {
    if (!reduceMotion) {
      let framePulse = 0;
      function tickFrames() {
        const speed = frameSpeed.value;
        if (speed > 0.08) framePulse = Math.min(1, framePulse + speed * 0.08);
        else framePulse *= 0.92;
        ditherFrames.forEach((state) => stepDitherFrame(state, framePulse));
        requestAnimationFrame(tickFrames);
      }
      requestAnimationFrame(tickFrames);
    } else {
      // Reduced motion: draw a single static dithered border, no particles.
      ditherFrames.forEach((state) => drawDitherEdge(state));
    }
  }
</script>