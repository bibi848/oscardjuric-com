---
import Layout from '../layouts/Layout.astro';

// You can use TypeScript variables right here!
const skills = ["TypeScript", "Cloudflare Workers", "Astro", "HTML/CSS"];
---

<Layout title="About | Oscar Djuric">
  <h1>About Me</h1>
  <p>I build web projects using Cloudflare Workers and Astro.</p>
  
  <h2>Skills</h2>
  <ul>
    {skills.map((skill) => <li>{skill}</li>)}
  </ul>
</Layout>