---
interface Props {
  title: string;
}
const { title } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects"},
  { href: "/contact", label: "Contact" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <nav class="topbar-inner">
        <a class="brand" href="/">OSCAR DJURIC</a>
        <ul class="nav-links">
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Oscar Djuric</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-black: #0a0a0a;
    --color-fuchsia: #d6006c;
    --color-white: #ffffff;
    --color-fuchsia-soft: #ff4fa3;
    --font-body: 'Helvetica Neue', Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    background-color: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-body);
  }

  /* --- Top bar --- */
  .topbar {
    width: 100%;
    background-color: var(--color-fuchsia);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .topbar-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
  }

  .brand {
    color: var(--color-black);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-size: 0.9rem;
    transition: opacity 0.15s ease;
  }

  .nav-links a:hover {
    opacity: 0.6;
  }

  /* --- Main content --- */
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    min-height: 70vh;
  }

  h1, h2, h3 {
    color: var(--color-white);
  }

  h1 {
    font-size: 2.75rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    color: var(--color-fuchsia-soft);
    font-size: 1.5rem;
    margin-top: 2.5rem;
  }

  a {
    color: var(--color-fuchsia-soft);
  }

  .accent {
    color: var(--color-fuchsia);
  }

  footer {
    text-align: center;
    padding: 1.5rem;
    color: #888;
    font-size: 0.85rem;
    border-top: 1px solid #222;
  }
</style>