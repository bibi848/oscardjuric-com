---
interface Props {
  title: string;
}
const { title } = Astro.props;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/experience", label: "Experience" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Asimovian&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/Images/eye-icon.png" />
  </head>
  <body>
    <header class="topbar">
      <canvas id="topbar-canvas"></canvas>
      <a class="brand" href="/">Oscar Djuric</a>

      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="squircle-menu"
      >
        <span class="line line1"></span>
        <span class="line line2"></span>
        <span class="line line3"></span>
      </button>
    </header>

    <nav id="squircle-menu" class="squircle-menu" aria-hidden="true">
      {navLinks.map((link, i) => (
        <a href={link.href} class={`squircle squircle-${i + 1}`}>
          {link.label}
        </a>
      ))}
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Oscar Djuric</p>
    </footer>

    <script>
      // Navigation Menu Controls
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("squircle-menu");

      const closeMenu = () => {
        toggle?.classList.remove("open");
        menu?.classList.remove("open");
        toggle?.setAttribute("aria-expanded", "false");
        menu?.setAttribute("aria-hidden", "true");
      };

      const openMenu = () => {
        toggle?.classList.add("open");
        menu?.classList.add("open");
        toggle?.setAttribute("aria-expanded", "true");
        menu?.setAttribute("aria-hidden", "false");
      };

      toggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = toggle.classList.contains("open");
        isOpen ? closeMenu() : openMenu();
      });

      document.addEventListener("click", (e) => {
        if (!menu?.classList.contains("open")) return;
        const target = e.target as Node;
        if (menu.contains(target) || toggle?.contains(target)) return;
        closeMenu();
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeMenu();
      });

      menu?.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", closeMenu);
      });

    // --- Topbar Canvas Particle Rain & Dither Engine ---
    const canvas = document.getElementById("topbar-canvas") as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext("2d");
      const HEADER_HEIGHT = 50; 
      const TRANSITION_HEIGHT = 14; // Dither transition zone at the bar's edge
      const DITHER_HEIGHT = 90;    // Generous height to prevent bottom clipping
    
      // 4x4 Bayer Matrix for a seamless threshold transition on the edge
      const BAYER4 = [
        [0, 8, 2, 10],
        [12, 4, 14, 6],
        [3, 11, 1, 9],
        [15, 7, 13, 5],
      ].map((row) => row.map((v) => (v + 0.5) / 16));
    
      interface Particle {
        x: number;
        y: number;
        size: number;
        vy: number;
        vx: number;
        alpha: number;
        decay: number;
      }
    
      let particles: Particle[] = [];
    
      const resizeCanvas = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const width = window.innerWidth;
        const totalHeight = HEADER_HEIGHT + DITHER_HEIGHT;
        
        canvas.width = width * dpr;
        canvas.height = totalHeight * dpr;
        canvas.style.width = `${width}px`;
        canvas.style.height = `${totalHeight}px`;
        if (ctx) ctx.scale(dpr, dpr);
      };
    
      const spawnParticles = () => {
        const count = Math.floor(window.innerWidth / 18);
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.floor(Math.random() * window.innerWidth),
            // Spawn slightly inside the transition zone for a seamless origin
            y: HEADER_HEIGHT - Math.random() * TRANSITION_HEIGHT,
            size: Math.random() > 0.6 ? 2 : 3,
            vy: 0.08 + Math.random() * 0.18, // Slow downward drift
            vx: (Math.random() - 0.5) * 0.1,
            alpha: 0.7 + Math.random() * 0.3,
            decay: 0.02 + Math.random() * 0.025, // Quick fade
          });
        }
      };
    
      const render = () => {
        if (!ctx) return;
        const width = window.innerWidth;
        const totalHeight = HEADER_HEIGHT + DITHER_HEIGHT;
      
        ctx.clearRect(0, 0, width, totalHeight);
      
        // 1. Solid Top Block
        ctx.fillStyle = "#af4a5a";
        ctx.fillRect(0, 0, width, HEADER_HEIGHT - TRANSITION_HEIGHT);
      
        // 2. Bayer Dithered Edge Transition (Blends the solid bar into particles)
        for (let py = HEADER_HEIGHT - TRANSITION_HEIGHT; py < HEADER_HEIGHT; py += 2) {
          const progress = (py - (HEADER_HEIGHT - TRANSITION_HEIGHT)) / TRANSITION_HEIGHT;
          const threshold = 1 - progress;
        
          for (let px = 0; px < width; px += 2) {
            const matrixVal = BAYER4[Math.floor(py / 2) % 4][Math.floor(px / 2) % 4];
            if (threshold > matrixVal) {
              ctx.fillRect(px, py, 2, 2);
            }
          }
        }
      
        // 3. Floating Dither Particles
        if (Math.random() < 0.5) spawnParticles();
      
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.y += p.vy;
          p.x += p.vx;
          p.alpha -= p.decay;
        
          // Clean removal before reaching bottom edge
          if (p.alpha <= 0 || p.y >= totalHeight - 2) {
            particles.splice(i, 1);
            continue;
          }
        
          ctx.fillStyle = `rgba(175, 74, 90, ${Math.max(0, p.alpha)})`;
          ctx.fillRect(Math.floor(p.x), Math.floor(p.y), p.size, p.size);
        }
      
        requestAnimationFrame(render);
      };
    
      window.addEventListener("resize", resizeCanvas);
      resizeCanvas();
      render();
    }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-black: #0a0a0a;
    --color-fuchsia: #af4a5a;
    --color-fuchsia-soft: #b73f53;
    --color-white: #c1b48e;
    --font-display: 'Asimovian', 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
    --font-body: 'Helvetica Neue', Helvetica, Arial, system-ui, -apple-system, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  html, body {
    margin: 0;
    padding: 0;
    background-color: var(--color-black);
    color: var(--color-white);
    font-family: var(--font-body);
  }

  /* --- Top Bar --- */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 58px;
    z-index: 150;
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    background: transparent;
  }

  #topbar-canvas {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: -1;
    image-rendering: pixelated;
  }

  .brand {
    color: var(--color-black);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
    z-index: 160;
  }

  /* --- Hamburger Toggle --- */
  .menu-toggle {
    margin-left: auto;
    background: transparent;
    border: none;
    padding: 8px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    z-index: 210;
  }

  .menu-toggle .line {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-black);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .menu-toggle.open .line1 {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle.open .line2 {
    opacity: 0;
  }

  .menu-toggle.open .line3 {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* --- Vertical Squircle Bubbles Menu --- */
  .squircle-menu {
    position: fixed;
    top: 70px;
    right: 1.5rem;
    z-index: 200;
    display: flex;
    flex-direction: column;
    gap: 10px;
    pointer-events: none;
  }

  .squircle {
    width: 140px;
    height: 52px;
    background-color: var(--color-fuchsia);
    color: var(--color-black);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: 0.02em;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(-15px) scale(0.9);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s ease, background-color 0.2s ease, color 0.2s ease;
    pointer-events: none;
  }

  .squircle-1 { transition-delay: 0.03s; }
  .squircle-2 { transition-delay: 0.08s; }
  .squircle-3 { transition-delay: 0.13s; }
  .squircle-4 { transition-delay: 0.18s; }

  .squircle-menu.open .squircle {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .squircle:hover,
  .squircle:focus-visible {
    background-color: var(--color-white);
    color: var(--color-black);
    transform: translateY(-2px) scale(1.03);
  }

  /* --- Main Content Layout --- */
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 1.5rem 5rem;
    min-height: 70vh;
  }

  h1, h2, h3 {
    color: var(--color-white);
    font-family: var(--font-display);
    font-weight: 700;
  }

  h1 {
    font-size: 2.75rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    color: var(--color-fuchsia-soft);
    font-size: 1.4rem;
    margin-top: 2.5rem;
    font-weight: 600;
  }

  a {
    color: var(--color-fuchsia-soft);
  }

  footer {
    text-align: center;
    padding: 1.5rem;
    color: #888;
    font-size: 0.85rem;
    border-top: 1px solid #222;
  }
</style>