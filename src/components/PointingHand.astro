<div class="pointing-hand" id="pointing-hand" aria-hidden="true">
  <canvas class="pointing-hand-canvas" id="pointing-hand-canvas"></canvas>
</div>

<style>
  .pointing-hand {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 8;
    width: clamp(220px, 24vw, 380px);
    aspect-ratio: 780 / 470;
    pointer-events: none;
    will-change: transform;
    /* Starting/rest position — kept in sync with HAND_REST_X below. */
    transform: translate3d(105%, -50%, 0);
  }

  .pointing-hand-canvas {
    display: block;
    width: 100%;
    height: 100%;
    user-select: none;
    image-rendering: pixelated;
    image-rendering: -webkit-optimize-contrast;
  }

  @media (max-width: 900px), (pointer: coarse) {
    .pointing-hand {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pointing-hand {
      display: none;
    }
  }
</style>

<script>
  // POINTING HAND PARAMETERS
  const HAND_WORK_WIDTH = 260;
  const HAND_REST_X = 1.05;
  const HAND_FINGER_GAP = 24;       // px gap between fingertip and box
  const HAND_FOLLOW = 0.3;
  const HAND_VERTICAL_OFFSET = 40;
  const DITHER_ENABLED = true;
  const HAND_TARGET_SELECTOR = '.preview-block, .framed-cta';

  const PALETTE: [number, number, number][] = [
    [10, 10, 10],
    [58, 22, 32],
    [175, 74, 90],
    [230, 217, 233],
  ];

  function luminance(r: number, g: number, b: number) {
    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
  }

  const PAL_LUM = PALETTE.map(([r, g, b]) => luminance(r, g, b));

  const BAYER4 = [
    [0, 8, 2, 10],
    [12, 4, 14, 6],
    [3, 11, 1, 9],
    [15, 7, 13, 5],
  ].map((row) => row.map((v) => (v + 0.5) / 16));

  function blurAlpha(
    alpha: Float32Array,
    w: number,
    h: number,
    radius: number
  ) {
    if (radius <= 0) return alpha;

    const tmp = new Float32Array(w * h);
    const out = new Float32Array(w * h);
    const span = radius * 2 + 1;

    for (let y = 0; y < h; y++) {
      let sum = 0;

      for (let x = -radius; x <= radius; x++) {
        const xx = Math.min(w - 1, Math.max(0, x));
        sum += alpha[y * w + xx];
      }

      for (let x = 0; x < w; x++) {
        tmp[y * w + x] = sum / span;

        const addX = Math.min(w - 1, x + radius + 1);
        const remX = Math.max(0, x - radius);

        sum += alpha[y * w + addX] - alpha[y * w + remX];
      }
    }

    for (let x = 0; x < w; x++) {
      let sum = 0;

      for (let y = -radius; y <= radius; y++) {
        const yy = Math.min(h - 1, Math.max(0, y));
        sum += tmp[yy * w + x];
      }

      for (let y = 0; y < h; y++) {
        out[y * w + x] = sum / span;

        const addY = Math.min(h - 1, y + radius + 1);
        const remY = Math.max(0, y - radius);

        sum += tmp[addY * w + x] - tmp[remY * w + x];
      }
    }

    return out;
  }

  function ditherImageData(imageData: ImageData): ImageData {
    const { width: w, height: h, data } = imageData;
    const count = w * h;

    const srcAlpha = new Float32Array(count);
    const gray = new Float32Array(count);

    for (let i = 0; i < count; i++) {
      const o = i * 4;
      srcAlpha[i] = data[o + 3];
      gray[i] = luminance(data[o], data[o + 1], data[o + 2]);
    }

    const softenedAlpha = blurAlpha(srcAlpha, w, h, 3);
    const out = new ImageData(w, h);
    const lastPal = PAL_LUM.length - 1;

    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = y * w + x;
        const o = i * 4;

        const threshold = BAYER4[y % 4][x % 4];
        const l = gray[i];

        let idx = 0;

        if (l <= PAL_LUM[0]) {
          idx = 0;
        } else if (l >= PAL_LUM[lastPal]) {
          idx = lastPal;
        } else {
          let lo = 0;

          while (
            lo < lastPal - 1 &&
            l > PAL_LUM[lo + 1]
          ) {
            lo++;
          }

          const frac =
            (l - PAL_LUM[lo]) /
            (PAL_LUM[lo + 1] - PAL_LUM[lo]);

          idx = frac > threshold ? lo + 1 : lo;
        }

        const [r, g, b] = PALETTE[idx];
        const alpha = softenedAlpha[i] / 255;
        const alphaOn = alpha > threshold;

        out.data[o] = r;
        out.data[o + 1] = g;
        out.data[o + 2] = b;
        out.data[o + 3] =
          idx === 0 || !alphaOn ? 0 : 255;
      }
    }

    return out;
  }

  function loadImage(src: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();

      img.onload = () => resolve(img);
      img.onerror = () =>
        reject(new Error(`Failed to load ${src}`));

      img.src = src;
    });
  }

  async function renderHand(
    src: string,
    canvas: HTMLCanvasElement
  ) {
    const img = await loadImage(src);

    const w = HAND_WORK_WIDTH;
    const h = Math.round(
      w *
        (img.naturalHeight /
          img.naturalWidth ||
          470 / 780)
    );

    canvas.width = w;
    canvas.height = h;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    ctx.clearRect(0, 0, w, h);
    ctx.drawImage(img, 0, 0, w, h);

    if (!DITHER_ENABLED) return;

    const raw = ctx.getImageData(
      0,
      0,
      w,
      h
    );

    ctx.putImageData(
      ditherImageData(raw),
      0,
      0
    );
  }

  const hand = document.getElementById(
    'pointing-hand'
  );

  const handCanvas =
    document.getElementById(
      'pointing-hand-canvas'
    ) as HTMLCanvasElement | null;

  const targets = Array.from(
    document.querySelectorAll<HTMLElement>(
      HAND_TARGET_SELECTOR
    )
  );

  if (
    hand &&
    handCanvas &&
    targets.length &&
    !hand.dataset.bound
  ) {
    hand.dataset.bound = 'true';

    renderHand(
      '/Images/pointing_hand.png',
      handCanvas
    ).catch((err) => {
      console.warn(
        '[PointingHand] could not load hand asset:',
        err
      );

      hand.style.display = 'none';
    });

    const reduceMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    let targetX = 0;
    let targetY = 0;

    let currentX = 0;
    let currentY = 0;

    let activeTarget: HTMLElement | null = null;

    let animationFrame = 0;

    /*
     * The hand is positioned from the viewport's right edge.
     * Instead of giving it a fixed percentage offset, we calculate
     * where the box actually is and put the fingertip a fixed
     * distance away from it.
     */
    function getRestX() {
      const handWidth =
        hand!.getBoundingClientRect().width;

      return handWidth * HAND_REST_X;
    }

    function applyTransform() {
      hand!.style.transform =
        `translate3d(${currentX}px, calc(-50% + ${currentY}px), 0)`;
    }

    function pointAt(el: HTMLElement) {
      activeTarget = el;

      const rect =
        el.getBoundingClientRect();

      const handRect =
        hand!.getBoundingClientRect();

      const viewportCenter =
        window.innerHeight / 2;

      /*
       * The hand's natural position is with its right edge
       * against the viewport's right edge.
       *
       * We move it left/right until the left side of the hand
       * sits HAND_FINGER_GAP pixels to the right of the box.
       */
      const desiredHandLeft =
        rect.right + HAND_FINGER_GAP;

      const baseHandLeft =
        window.innerWidth -
        handRect.width;

      targetX =
        desiredHandLeft -
        baseHandLeft;

      targetY =
        rect.top +
        rect.height / 2 -
        viewportCenter +
        HAND_VERTICAL_OFFSET;

      if (reduceMotion) {
        currentX = targetX;
        currentY = targetY;
        applyTransform();
      }
    }

    function retreat() {
      activeTarget = null;

      targetX = getRestX();

      if (reduceMotion) {
        currentX = targetX;
        applyTransform();
      }
    }

    function animate() {
      currentX +=
        (targetX - currentX) *
        HAND_FOLLOW;

      currentY +=
        (targetY - currentY) *
        HAND_FOLLOW;

      applyTransform();

      animationFrame =
        requestAnimationFrame(animate);
    }

    targets.forEach((el) => {
      el.addEventListener(
        'mouseenter',
        () => pointAt(el)
      );

      el.addEventListener(
        'mouseleave',
        retreat
      );

      el.addEventListener(
        'focusin',
        () => pointAt(el)
      );

      el.addEventListener(
        'focusout',
        retreat
      );
    });

    /*
     * Recalculate the hand position whenever the viewport
     * changes size. This prevents the hand from drifting
     * into the box on narrower screens.
     */
    window.addEventListener('resize', () => {
      if (activeTarget) {
        pointAt(activeTarget);
      } else {
        targetX = getRestX();
      }
    });

    // Initial resting position.
    targetX = getRestX();
    currentX = targetX;

    applyTransform();

    if (!reduceMotion) {
      animationFrame =
        requestAnimationFrame(animate);
    }
  }
</script>