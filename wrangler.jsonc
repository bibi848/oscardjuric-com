{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "oscardjuric-com",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"routes": [
		{
			"pattern": "oscardjuric.com",
			"custom_domain": true
		},
		{
			"pattern": "www.oscardjuric.com",
			"custom_domain": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "7971cc3650604af3985f8c95ee5b58b1",
			"remote": true
		}
	]
}